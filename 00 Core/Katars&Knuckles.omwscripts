# Load this after ReAnimation_API.omwscripts: animations.lua talks to I.ReAnimation when it loads.
# content.lua runs once at game start and makes the records the two uniques' magic uses.
LOAD: scripts/MaxYari/H2HWeapons/content.lua
GLOBAL: scripts/MaxYari/H2HWeapons/global.lua
PLAYER: scripts/MaxYari/H2HWeapons/player.lua
# npc.lua and animations.lua run on creatures too, but only a two-legged one that fights with weapons
# (dremora, golden saints, liches, skeletons; weapons.canWield) keeps them: on any other both return as
# they load, with no handlers.
NPC, CREATURE: scripts/MaxYari/H2HWeapons/npc.lua
NPC, CREATURE, PLAYER: scripts/MaxYari/H2HWeapons/actor.lua
NPC, CREATURE, PLAYER: scripts/MaxYari/H2HWeapons/animations.lua
# The banner on the settings page: setting renderers can only be registered in the menu.
MENU: scripts/MaxYari/H2HWeapons/menu.lua
