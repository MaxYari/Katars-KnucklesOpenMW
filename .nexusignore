# Left out of the Nexus archive (gitignore syntax). Only files committed to git are packed in the
# first place, so local junk never ends up in there.
# Preview what gets packed: bash tools/build_nexus_zip.sh && unzip -l nexus-upload.zip

# git and tooling
.git*
.nexusignore
.claude/
tools/
__pycache__/

# docs and images (the README lives on the Nexus page itself)
/README.md
/README.nexus.bbcode
imgs/

# Blender and art sources, and the scripts that build the mod from them - all of it in the git
# repository only (Sources/Tools/README.md and tools/README.md there say how to use them).
Sources/
*.blend
*.blend1
*.rar

# Baking inputs for the weapon textures - build-time only.
bake_source/

# A crate of every item by the Seyda Neen lighthouse (Sources/Tools/make_test_crate.py): for testing only.
Katars_FOR_TESTING_ONLY_Crate_With_All_Items.omwaddon
