# Left out of the Nexus archive (gitignore syntax). Only files committed to git are packed in the
# first place, so local junk never ends up in there.
# Preview what gets packed: bash tools/build_nexus_zip.sh && unzip -l nexus-upload.zip

# git and tooling
.git*
.nexusignore
.claude/
tools/
__pycache__/

# docs and images (the README lives on the Nexus page itself)
/README.md
/README.nexus.bbcode
imgs/

# Blender sources and the scripts that build the meshes from them. The skeleton patcher is the
# exception: users run that one themselves when another mod replaces the skeletons.
Sources/*
!Sources/Tools/
Sources/Tools/*
!Sources/Tools/patch_skeleton.py
!Sources/Tools/mirror_weapon_track.py
*.blend
*.blend1
*.rar

# Baking inputs for the weapon textures - build-time only.
bake_source/
