# Local output of tools/build_nexus_zip.sh
nexus-upload.zip
__pycache__/
*.blend1
*.blend2
.claude/

# The loose vanilla Morrowind textures here are only so the Blender source has something to preview
# against; they ship with the game, so they do not belong in the repo or the release. Extract them
# again if you need them in Blender.
#
# Textures baked for this mod go in textures/katars/ and DO ship - that is the one path under
# textures/ that is tracked, so put new ones there (or add another exception below).
/textures/*
!/textures/katars/
