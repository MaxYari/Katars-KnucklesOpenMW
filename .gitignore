# Local output of tools/build_nexus_zip.sh
nexus-upload.zip
__pycache__/
*.blend1
*.blend2
.claude/

# Vanilla Morrowind textures, kept here only so the Blender source has something to preview
# against. Every texture the exported meshes use ships with the game (Morrowind.bsa +
# Tribunal.bsa), so none of that belongs in the repo or the release; extract them again if you
# need them in Blender. Textures baked for this mod, under textures/katars/, do ship.
/textures/*
!/textures/katars/
