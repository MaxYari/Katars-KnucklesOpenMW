#!/bin/sh
# Keeps README.nexus.bbcode (the Nexus mod page description) in sync with README.md.
# Enable once per clone: git config core.hooksPath .githooks
# It converts README.md as staged, so a commit carrying part of the README's changes gets the
# description of just that part. Links point at main, the branch releases are made from,
# whichever branch the commit is on.
readme=$(git show :README.md) || exit 1
printf '%s\n' "$readme" | python3 tools/readme_to_nexus.py - -o README.nexus.bbcode || exit 1
git add README.nexus.bbcode
